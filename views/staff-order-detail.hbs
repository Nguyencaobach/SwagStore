<div class="staff-page">

  <!-- Header -->
  <div class="staff-header">
    <div class="staff-header-inner">
      <div>
        <h1 class="staff-title">&#128203; Chi tiết đơn hàng</h1>
        <p class="staff-subtitle order-id-display">{{order.id}}</p>
      </div>
      <a href="/staff/orders" class="btn-staff-secondary">&larr; Danh sách đơn</a>
    </div>
  </div>

  <!-- Alerts -->
  {{#if success}}
  <div class="alert alert-success" id="alert-success">
    &#10003; Cập nhật trạng thái thành công!
  </div>
  {{/if}}
  {{#if error}}
  <div class="alert alert-error" id="alert-error">
    &#10007; {{error}}
  </div>
  {{/if}}

  <div class="order-detail-grid">

    <!-- Left: Order info -->
    <div class="order-detail-main">

      <!-- Customer info -->
      <div class="detail-card">
        <h2 class="detail-card-title">&#128100; Thông tin khách hàng</h2>
        <div class="detail-rows">
          <div class="detail-row">
            <span class="detail-label">Họ tên</span>
            <span class="detail-value">{{order.name}}</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Email</span>
            <span class="detail-value">{{order.email}}</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Địa chỉ giao</span>
            <span class="detail-value">{{order.address}}</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Ngày đặt</span>
            <span class="detail-value">{{order.placedAt}}</span>
          </div>
        </div>
      </div>

      <!-- Items -->
      <div class="detail-card">
        <h2 class="detail-card-title">&#128717; Sản phẩm</h2>
        <table class="items-table">
          <thead>
            <tr>
              <th>Sản phẩm</th>
              <th class="text-center">SL</th>
              <th class="text-right">Đơn giá</th>
              <th class="text-right">Thành tiền</th>
            </tr>
          </thead>
          <tbody>
            {{#each order.items}}
            <tr>
              <td>
                <div class="item-name">{{this.product.name}}</div>
                <div class="item-meta text-muted">{{this.product.category}}</div>
              </td>
              <td class="text-center">{{this.qty}}</td>
              <td class="text-right">${{this.product.price}}</td>
              <td class="text-right item-subtotal">${{times this.product.price this.qty}}</td>
            </tr>
            {{/each}}
          </tbody>
          <tfoot>
            <tr class="total-row">
              <td colspan="3" class="text-right">Tổng cộng</td>
              <td class="text-right order-total">${{order.total}}</td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>

    <!-- Right: Status management -->
    <div class="order-detail-sidebar">
      <div class="detail-card status-card">
        <h2 class="detail-card-title">&#128204; Trạng thái hiện tại</h2>
        <div class="current-status">
          <span class="badge badge-{{order.status}} badge-lg">{{order.statusLabel}}</span>
        </div>

        <!-- Status flow diagram -->
        <div class="status-flow">
          <div class="flow-step {{#if (eq order.status 'confirmed')}}flow-active{{/if}} {{#if (eq order.status 'processing')}}flow-done{{/if}} {{#if (eq order.status 'shipped')}}flow-done{{/if}} {{#if (eq order.status 'delivered')}}flow-done{{/if}}">
            <div class="flow-dot"></div>
            <div class="flow-label">Đã xác nhận</div>
          </div>
          <div class="flow-line"></div>
          <div class="flow-step {{#if (eq order.status 'processing')}}flow-active{{/if}} {{#if (eq order.status 'shipped')}}flow-done{{/if}} {{#if (eq order.status 'delivered')}}flow-done{{/if}}">
            <div class="flow-dot"></div>
            <div class="flow-label">Đang xử lý</div>
          </div>
          <div class="flow-line"></div>
          <div class="flow-step {{#if (eq order.status 'shipped')}}flow-active{{/if}} {{#if (eq order.status 'delivered')}}flow-done{{/if}}">
            <div class="flow-dot"></div>
            <div class="flow-label">Đang giao</div>
          </div>
          <div class="flow-line"></div>
          <div class="flow-step {{#if (eq order.status 'delivered')}}flow-active flow-done{{/if}}">
            <div class="flow-dot"></div>
            <div class="flow-label">Đã giao</div>
          </div>
        </div>

        <!-- Update form -->
        <form method="POST" action="/staff/orders/{{order.id}}/status" class="status-form" id="update-status-form">
          <label class="form-label" for="status-select">Cập nhật trạng thái</label>
          <select name="status" id="status-select" class="status-select">
            {{#each statuses}}
            <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
            {{/each}}
          </select>
          <button type="submit" class="btn-staff-primary btn-full" id="btn-update-status">
            &#10003; Cập nhật
          </button>
        </form>

        {{#if (eq order.status 'cancelled')}}
        <p class="status-note">&#9888; Đơn hàng đã bị huỷ.</p>
        {{/if}}
        {{#if (eq order.status 'delivered')}}
        <p class="status-note status-note-success">&#10003; Đơn hàng đã hoàn thành.</p>
        {{/if}}
      </div>
    </div>

  </div>
</div>
